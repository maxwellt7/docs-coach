# Railway sets PORT automatically.
PORT=8000

# Comma-separated browser/dashboard origins during local development and production.
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app|chrome-extension://.*

# Future integration points from maxmayes-chat. Keep these in Railway variables, not in Git.
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
